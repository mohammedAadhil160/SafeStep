# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://safestep:safestep@localhost:5432/safestep_db

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-64-char-random-string
DEBUG=true

# ── External APIs (optional) ─────────────────────────────────────────────────
# Google Maps API (for police station lookups)
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Twilio (for SOS SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# SendGrid (for SOS email notifications)
SENDGRID_API_KEY=your-sendgrid-key
